# Pinata IPFS (https://pinata.cloud)
VITE_PINATA_JWT=your_pinata_jwt_token

# Deployed ProofRegistry contract address on Polygon Amoy
VITE_HHGOA_CONTRACT_ADDRESS=0x7Ada4CaD2B63D2D6cB309c8606Af8b136c8838B9

# SerpApi for Google Lens reverse-image search (https://serpapi.com)
VITE_SERPAPI_KEY=your_serpapi_key

# Wallet private key (for contract deployment only — NEVER commit this)
